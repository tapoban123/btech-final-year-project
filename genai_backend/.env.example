# Groq API key (required)
GROQ_API_KEY=your-groq-api-key-here

# Tavily API key for web search fallback (required)
TAVILY_API_KEY=your-tavily-api-key-here

# Service-to-service API key for X-API-Key header auth
API_KEY=dev-api-key-change-in-production

# LangSmith tracing (optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=omnidoc-ai

# Database URL (default: SQLite)
DATABASE_URL=sqlite+aiosqlite:///./omnidoc.db

# File storage paths
UPLOAD_DIR=./uploads
FAISS_DIR=./faiss_indexes

# Debug mode
DEBUG=true
